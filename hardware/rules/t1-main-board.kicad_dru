(version 1)
# OpenDAP T1 main board: product rules
#
# The T1's own limits, composed on top of the PCBWay HDI fab rule set
# (kicad-lib design-rules/pcbway-hdi) and the OpenDAP craft rule set
# (kicad-lib design-rules/opendap-craft) into the project's
# <project>.kicad_dru. Rules PCB-G, -P, -A and -I enforce constraints of
# docs/specs/pcb-design-constraints.md (Draft v0.6); rules PCB-V, -H, -B, -D,
# -W and -L enforce the constraints of the same families there, and
# docs/research/2026-10-pcb-dfm-reliability-rules.md lists every value with
# its source, primary or secondary. The net
# classes the conditions use are in netclasses.toml; the reference, field,
# pad-property and rule-area conventions are in README.md.
#
# Names carry the lowest quality level at which the rule is mandatory
# (RFC 0010): "T1 PCB-H-01 [Q1]: ...".
# Severity: a rule at Q0 or Q1 whose value has a source is an error. A rule
# at Q2 to Q4, or one whose value is still UNVERIFIED, is a warning, seen at
# every DRC run without blocking a commit.
#
# KiCad applies the LAST matching rule for a constraint: general rules first,
# area and net-class overrides after them. Angles are bare degrees: KiCad
# 10.0.7 drops the whole file on "90deg".


# --- Geometry (PCB-G) ---

# PCB-G-01: general track and space 0.1 / 0.1 mm, margin over the fab minimum.
(rule "T1 PCB-G-01 [Q1]: Copper clearance"
	(constraint clearance (min 0.1mm))
)

(rule "T1 PCB-G-01 [Q1]: Track width"
	(constraint track_width (min 0.1mm))
)

# PCB-G-02: inside the RK3566 escape area (rule area named BGA_ESCAPE), the
# HDI floor 0.065 mm applies [P3]; it overrides PCB-G-01 there.
(rule "T1 PCB-G-02 [Q1]: Copper clearance in the BGA escape"
	(condition "A.intersectsArea('BGA_ESCAPE')")
	(constraint clearance (min 0.065mm))
)

(rule "T1 PCB-G-02 [Q1]: Track width in the BGA escape"
	(condition "A.intersectsArea('BGA_ESCAPE')")
	(constraint track_width (min 0.065mm))
)

# PCB-G-03: laser microvia land 0.25 mm (0.10 mm drill keeps the 3 mil ring).
(rule "T1 PCB-G-03 [Q1]: Microvia diameter"
	(condition "A.Type == 'Via' && A.Via_Type == 'Micro'")
	(constraint via_diameter (min 0.25mm))
)

# PCB-G-04: mechanical via pad 0.45 mm minimum (0.20 mm drill).
(rule "T1 PCB-G-04 [Q1]: Mechanical via diameter"
	(condition "A.Type == 'Via' && A.Via_Type != 'Micro'")
	(constraint via_diameter (min 0.45mm))
)

# PCB-G-05: copper to board edge 0.30 mm (fab 0.20 mm plus the outline
# tolerance).
(rule "T1 PCB-G-05 [Q1]: Copper to board edge"
	(constraint edge_clearance (min 0.3mm))
)

# --- Voltage spacing (PCB-V) ---
# IPC-2221B Table 6-1 (quoted by Altair's Pollex documentation, secondary):
# 0-15 V and 16-30 V need B1 internal 0.05 mm, B2 external uncoated 0.1 mm
# and B4 external under a polymer coating 0.05 mm, which PCB-G-01 and
# PCB-G-02 already meet. Uncoated component terminations (A6) need 0.13 mm
# at 0-15 V and 0.25 mm at 16-30 V: more than the general clearance, so the
# two rules below. A part's own pin spacing is the manufacturer's, so pad
# pairs of one footprint are left out (A.Parent != B.Parent). These rules
# come before the net-class clearances (PCB-A-06, PCB-I-09), which override
# them with larger values.

# PCB-V-01: every exposed termination (pad) on an outer layer to copper of
# another net, 0.13 mm (A6, 0-15 V: every net of the board in steady state).
# The RK3566 escape area keeps PCB-G-02.
(rule "T1 PCB-V-01 [Q1]: Exposed termination spacing"
	(layer outer)
	(condition "(A.Type == 'Pad' || B.Type == 'Pad') && A.Parent != B.Parent && !A.intersectsArea('BGA_ESCAPE') && !B.intersectsArea('BGA_ESCAPE')")
	(constraint clearance (min 0.13mm))
)

# PCB-V-02: VBUS input pads, 0.25 mm (A6, 16-30 V): VBUS can reach the
# TVS2200 clamp, 28.4 V, during a surge, and a faulty source can hold it
# above 15 V up to the 22 V standoff.
(rule "T1 PCB-V-02 [Q1]: VBUS termination spacing"
	(layer outer)
	(condition "((A.Type == 'Pad' && A.hasNetclass('PWR_VBUS')) || (B.Type == 'Pad' && B.hasNetclass('PWR_VBUS'))) && A.Parent != B.Parent")
	(constraint clearance (min 0.25mm))
)


# --- Power (PCB-P) ---
# Track minimums from the IPC-2221 formula at a 10 degC rise: outer layers at
# 35 um finished copper, inner layers at 18 um (HDI base copper). Pours are
# the intended conductors for PCB-P-01 to PCB-P-03; these rules catch a thin
# track on those nets.

(rule "T1 PCB-P-01 [Q0]: Battery path track width (outer)"
	(layer outer)
	(condition "A.hasNetclass('PWR_BAT')")
	(constraint track_width (min 2.8mm))
)

(rule "T1 PCB-P-01 [Q0]: Battery path track width (inner)"
	(layer inner)
	(condition "A.hasNetclass('PWR_BAT')")
	(constraint track_width (min 14.0mm))
)

(rule "T1 PCB-P-02 [Q0]: VSYS track width (outer)"
	(layer outer)
	(condition "A.hasNetclass('PWR_VSYS')")
	(constraint track_width (min 1.5mm))
)

(rule "T1 PCB-P-02 [Q0]: VSYS track width (inner)"
	(layer inner)
	(condition "A.hasNetclass('PWR_VSYS')")
	(constraint track_width (min 7.6mm))
)

(rule "T1 PCB-P-03 [Q0]: VBUS input track width (outer)"
	(layer outer)
	(condition "A.hasNetclass('PWR_VBUS')")
	(constraint track_width (min 1.4mm))
)

(rule "T1 PCB-P-03 [Q0]: VBUS input track width (inner)"
	(layer inner)
	(condition "A.hasNetclass('PWR_VBUS')")
	(constraint track_width (min 6.9mm))
)

(rule "T1 PCB-P-04 [Q0]: 5.1 V source track width (outer)"
	(layer outer)
	(condition "A.hasNetclass('PWR_5V1')")
	(constraint track_width (min 0.6mm))
)

(rule "T1 PCB-P-04 [Q0]: 5.1 V source track width (inner)"
	(layer inner)
	(condition "A.hasNetclass('PWR_5V1')")
	(constraint track_width (min 3.1mm))
)

(rule "T1 PCB-P-05 [Q0]: HAT 3.3 V track width (outer)"
	(layer outer)
	(condition "A.hasNetclass('PWR_HAT3V3')")
	(constraint track_width (min 0.3mm))
)

(rule "T1 PCB-P-05 [Q0]: HAT 3.3 V track width (inner)"
	(layer inner)
	(condition "A.hasNetclass('PWR_HAT3V3')")
	(constraint track_width (min 1.5mm))
)

# PCB-P-06: amplifier rails, 0.3 mm on every layer (the current needs less;
# the width keeps the rail impedance low).
(rule "T1 PCB-P-06 [Q1]: Amplifier rail track width"
	(condition "A.hasNetclass('PWR_AMP')")
	(constraint track_width (min 0.3mm))
)


# --- Audio (PCB-A) and clocks (PCB-I-09) ---

# PCB-A-06: switch nodes and power inductors away from the analog audio
# copper. 5 mm is UNVERIFIED until the power and audio test board (E5.2).
(rule "T1 PCB-A-06 [Q1]: Switch node to analog audio"
	(severity warning)
	(condition "(A.hasNetclass('SW_NODE') && B.hasNetclass('AUDIO_ANALOG')) || (B.hasNetclass('SW_NODE') && A.hasNetclass('AUDIO_ANALOG'))")
	(constraint clearance (min 5mm))
)

# PCB-A-07: no digital or switching track inside the analog audio area (rule
# area named AUDIO_ANALOG). Allowed there: analog audio, amplifier rails,
# DAC references and ground.
(rule "T1 PCB-A-07 [Q1]: Foreign track in the analog audio area"
	(condition "A.Type == 'Track' && A.intersectsArea('AUDIO_ANALOG') && !A.hasNetclass('AUDIO_ANALOG') && !A.hasNetclass('AUDIO_REF') && !A.hasNetclass('PWR_AMP') && A.NetName != 'GND'")
	(constraint disallow track)
)

# PCB-I-09: the master clock runs on an inner layer between two ground
# planes, with spacing to every other signal; no guard traces (Hubing,
# LearnEMC). Spacing 3 x W: 0.3 mm (three times a 0.1 mm track) is
# UNVERIFIED until the stackup sets the clock trace width. The branch length
# limit (20 mm per branch, sim/mclk-attenuator) is a CHK item.
(rule "T1 PCB-I-09 [Q1]: Master clock to other nets"
	(severity warning)
	(condition "(A.hasNetclass('MCLK_50SE') && !B.hasNetclass('MCLK_50SE') && B.NetName != 'GND') || (B.hasNetclass('MCLK_50SE') && !A.hasNetclass('MCLK_50SE') && A.NetName != 'GND')")
	(constraint clearance (min 0.3mm))
)


# --- Mounting holes (PCB-H) ---
# Mounting holes are footprints H*. The screw is not chosen (M2 or M1.6
# class, UNVERIFIED), so the head rings are sized for the larger case: an M2
# screw with an ISO 7089 washer (outer diameter 5.0 mm) in an ISO 273 fine
# clearance hole (2.2 mm). Ring from the hole edge: (5.0 - 2.2) / 2 = 1.4 mm
# (arithmetic). Warnings until the case fixes the screw.

# PCB-H-01: no part under the screw head or washer: the courtyard of every
# other footprint keeps 1.4 mm from the mounting hole.
(rule "T1 PCB-H-01 [Q1]: Part under the screw head"
	(severity warning)
	(condition "A.memberOfFootprint('H*') && B.Type == 'Footprint' && B.Reference != 'H*'")
	(constraint physical_hole_clearance (min 1.4mm))
)

# PCB-H-02: no copper of another net under the head on the outer layers
# (a plated hole's own net, GND, may be there). Rockchip's high-speed guide
# also keeps traces away from mounting holes (HSPCB p. 12).
(rule "T1 PCB-H-02 [Q1]: Copper under the screw head"
	(severity warning)
	(layer outer)
	(condition "A.memberOfFootprint('H*')")
	(constraint hole_clearance (min 1.4mm))
)

# PCB-H-03: a plated mounting hole is on GND, never floating or on another
# net. Plated versus non-plated is not decided (research note, H section).
(rule "T1 PCB-H-03 [Q2]: Plated mounting hole on GND"
	(severity warning)
	(condition "A.Type == 'Pad' && A.memberOfFootprint('H*') && A.isPlated()")
	(constraint assertion "A.NetName == 'GND'")
)

# PCB-H-04: mounting hole to board edge 1.5 mm, the low end of the
# 1.5-2 mm that fabricators' design guides give against cracking (ALLPCB,
# secondary; no primary source: UNVERIFIED). The fab minimum is far lower
# (JLCPCB 0.4 mm, drill to outline).
(rule "T1 PCB-H-04 [Q1]: Mounting hole to board edge"
	(severity warning)
	(condition "A.memberOfFootprint('H*') && B.Layer == 'Edge.Cuts'")
	(constraint physical_hole_clearance (min 1.5mm))
)

# PCB-H-05: MLCCs (C*) away from the screw holes, which bend the board when
# the screws are tightened. Murata asks for "as far away from the screw holes
# as possible" without a number; 3 mm (the head ring plus 1.6 mm) is
# UNVERIFIED.
(rule "T1 PCB-H-05 [Q1]: MLCC to mounting hole"
	(severity warning)
	(condition "A.memberOfFootprint('H*') && B.Type == 'Footprint' && B.Reference == 'C*'")
	(constraint physical_hole_clearance (min 3mm))
)

# PCB-H-06: BGA balls away from the screw holes (board flex fatigues the
# joints). 5 mm is UNVERIFIED.
(rule "T1 PCB-H-06 [Q2]: BGA to mounting hole"
	(severity warning)
	(condition "A.memberOfFootprint('H*') && B.Fabrication_Property == 'BGA pad'")
	(constraint physical_hole_clearance (min 5mm))
)


# --- Board edges and panelisation (PCB-B) ---
# The board is routed and held in PCBWay's panel by tabs with rails [P20].
# Rule areas named BREAK_TAB mark each tab position on the outline.

# PCB-B-01: no courtyard closer than 0.3 mm to the board edge (the copper
# edge clearance PCB-G-05 applied to the part's body); edge connectors J*
# and side buttons SW* are exempt and may overhang. UNVERIFIED.
(rule "T1 PCB-B-01 [Q1]: Part to board edge"
	(severity warning)
	(condition "A.Type == 'Footprint' && B.Layer == 'Edge.Cuts' && A.Reference != 'J*' && A.Reference != 'SW*'")
	(constraint physical_clearance (min 0.3mm))
)

# PCB-B-02: copper to the edge at a break tab 0.4 mm, JLCPCB's figure for
# copper to a V-cut, the nearest published value for a broken edge
# (JLCPCB capabilities, Outline; PCBWay publishes none): UNVERIFIED for tabs.
(rule "T1 PCB-B-02 [Q1]: Copper to edge at a break tab"
	(severity warning)
	(condition "A.intersectsArea('BREAK_TAB')")
	(constraint edge_clearance (min 0.4mm))
)

# PCB-B-03: MLCCs at least 0.2 in (5.08 mm) from an edge that is broken at
# depanelisation (KYOCERA AVX, quoted by DigiKey TechForum, secondary). A
# routed edge is exempt by the same source, so the rule applies at tabs.
(rule "T1 PCB-B-03 [Q1]: MLCC at a break tab"
	(condition "A.Type == 'Footprint' && A.Reference == 'C*' && A.intersectsArea('BREAK_TAB') && B.Layer == 'Edge.Cuts'")
	(constraint physical_clearance (min 5.08mm))
)


# --- Assembly (PCB-D) ---

# PCB-D-01: a BGA that may need rework (footprint field Rework = BGA:
# RK3566, LPDDR4X, eMMC) keeps 2 mm courtyard to courtyard for the rework
# nozzle. UNVERIFIED.
(rule "T1 PCB-D-01 [Q1]: BGA rework clearance"
	(severity warning)
	(condition "A.getField('Rework') == 'BGA' || B.getField('Rework') == 'BGA'")
	(constraint courtyard_clearance (min 2mm))
)

# PCB-D-02: fiducial copper dot 1.0-3.0 mm, round (SMEMA 3.1 practice as
# quoted by LCSC's fiducial guide, secondary: 1.0 mm recommended).
(rule "T1 PCB-D-02 [Q1]: Fiducial size"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Fiducial*'")
	(constraint assertion "A.Size_X >= 1.0mm && A.Size_X <= 3.0mm && A.Size_Y == A.Size_X")
)

# PCB-D-03: fiducial clear area: a 3 mm diameter window around a 1 mm dot,
# so nothing within 1.0 mm of the dot's edge (LCSC, secondary).
(rule "T1 PCB-D-03 [Q1]: Fiducial clear area"
	(condition "A.Fabrication_Property == 'Fiducial*' && B.Type != 'Footprint' && B.Layer != 'Edge.Cuts'")
	(constraint physical_clearance (min 1mm))
)

# PCB-D-04: fiducial to board edge 3.85 mm (LCSC, secondary). With rails the
# conveyor holds the rails, so this is a Q2 item for unpanelised builds.
(rule "T1 PCB-D-04 [Q2]: Fiducial to board edge"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Fiducial*'")
	(constraint edge_clearance (min 3.85mm))
)

# PCB-D-05: silkscreen to board edge 0.3 mm, UNVERIFIED (no fab publishes
# one). KiCad 10.0.7 reports silk text near the edge and any silk the edge
# clips; silk lines inside the distance are a review item.
(rule "T1 PCB-D-05 [Q2]: Silkscreen to board edge"
	(severity warning)
	(condition "B.Layer == 'Edge.Cuts'")
	(constraint silk_clearance (min 0.3mm))
)

# Test points (TP*, pad property "Test point pad"): JLCPCB's DFT guide
# (secondary): pad 1.0-1.27 mm, 2.54 mm pitch for fixtures, 1.0 mm from
# component bodies, 3.8 mm from the edge. Production-test items: Q2.

# PCB-D-06: test pad at least 1.0 mm.
(rule "T1 PCB-D-06 [Q2]: Test point size"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Test point pad'")
	(constraint assertion "A.Size_X >= 1.0mm && A.Size_Y >= 1.0mm")
)

# PCB-D-07: 2.54 mm pitch between 1.0 mm pads: 1.54 mm edge to edge
# (arithmetic).
(rule "T1 PCB-D-07 [Q2]: Test point spacing"
	(severity warning)
	(condition "A.Fabrication_Property == 'Test point pad' && B.Fabrication_Property == 'Test point pad'")
	(constraint physical_clearance (min 1.54mm))
)

# PCB-D-08: test pad 1.0 mm from other parts' pads (the guide's distance
# to component bodies, measured to their pads; bodies are a review item).
(rule "T1 PCB-D-08 [Q2]: Test point to other pads"
	(severity warning)
	(condition "A.Fabrication_Property == 'Test point pad' && B.Type == 'Pad' && B.Fabrication_Property != 'Test point pad'")
	(constraint physical_clearance (min 1mm))
)

# PCB-D-09: test pad 3.8 mm from the board edge.
(rule "T1 PCB-D-09 [Q2]: Test point to board edge"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Test point pad'")
	(constraint edge_clearance (min 3.8mm))
)

# PCB-D-10: a via in or near an SMD pad wicks solder unless it is filled
# and capped (IPC-4761 type VII; PCBWay offers "filled with resin and
# capped" [P11, P16]). An open via keeps its hole 0.2 mm from SMD pads
# (UNVERIFIED distance); a filled and capped via may sit in the pad.
(rule "T1 PCB-D-10 [Q1]: Open via near an SMD pad"
	(severity warning)
	(condition "A.Type == 'Via' && B.Pad_Type == 'SMD' && !(A.Filling == 'Filled' && A.Capping == 'Capped')")
	(constraint physical_hole_clearance (min 0.2mm))
)


# --- Routing hygiene (PCB-W) ---
# Acute angles (acid traps), 45-degree routing and short segments are in the
# craft rule set (CRAFT-40, -41, -47); not repeated here.

# PCB-W-01: no copper neck or sliver narrower than the narrowest track:
# 0.1 mm (PCB-G-01), 0.065 mm in the RK3566 escape (PCB-G-02, PCBWay HDI
# [P3]). Catches pours necked between obstacles. KiCad 10.0.7 reports a neck
# only when it is about 0.01 mm or more under the limit.
(rule "T1 PCB-W-01 [Q1]: Copper neck"
	(severity error)
	(constraint connection_width (min 0.1mm))
)

(rule "T1 PCB-W-01 [Q1]: Copper neck in the BGA escape"
	(severity error)
	(condition "A.intersectsArea('BGA_ESCAPE')")
	(constraint connection_width (min 0.065mm))
)

# PCB-W-02: teardrops on every via, for the HDI's 0.075 mm microvia ring
# (PCBWay minimum [P2, P3]): they keep the track joined if the drill wanders.
# UNVERIFIED as a requirement (no fab or IPC text retrieved).
(rule "T1 PCB-W-02 [Q2]: Teardrops on vias"
	(severity warning)
	(condition "A.Type == 'Via'")
	(constraint assertion "A.Enable_Teardrops")
)

# PCB-W-03: vias per net of a high-speed pair, from Rockchip's high-speed PCB
# guide as copied in docs/research/2026-10-rk3566-layout-rules.md: USB 3
# and PCIe at most 2 (Tables 2, 5), MIPI at most 4 (Table 10), USB 2 never
# more than 6 (Table 1). Signal-integrity items: Q2.
(rule "T1 PCB-W-03 [Q2]: Vias per USB 2 line"
	(severity warning)
	(condition "A.hasNetclass('USB2_90D')")
	(constraint via_count (max 6))
)

(rule "T1 PCB-W-03 [Q2]: Vias per USB 3 line"
	(severity warning)
	(condition "A.hasNetclass('USB3_90D')")
	(constraint via_count (max 2))
)

(rule "T1 PCB-W-03 [Q2]: Vias per PCIe line"
	(severity warning)
	(condition "A.hasNetclass('PCIE_85D')")
	(constraint via_count (max 2))
)

(rule "T1 PCB-W-03 [Q2]: Vias per MIPI line"
	(severity warning)
	(condition "A.hasNetclass('MIPI_100D')")
	(constraint via_count (max 4))
)


# --- Battery and heat placement (PCB-L) ---
# Safety items (BRD-049): Q0. Their distances are UNVERIFIED, so warnings.

# PCB-L-01: no heat source (footprint field Thermal = hot: converters,
# eFuses, charger, SoC, PMIC) over the battery pocket. The rule area
# BATTERY_POCKET is the pocket's footprint grown by a margin, 3 mm
# UNVERIFIED (README.md).
(rule "T1 PCB-L-01 [Q0]: Hot part at the battery pocket"
	(severity warning)
	(condition "A.Type == 'Footprint' && A.getField('Thermal') == 'hot' && A.intersectsArea('BATTERY_POCKET')")
	(constraint disallow footprint)
)

# PCB-L-02: inside the battery connector area (rule area BATTERY_CONNECTOR),
# only unfused battery copper (PWR_BAT) and GND: no other net's track or via
# where a short has no fuse ahead of it.
(rule "T1 PCB-L-02 [Q0]: Foreign track at the battery connector"
	(severity warning)
	(condition "(A.Type == 'Track' || A.Type == 'Via') && A.intersectsArea('BATTERY_CONNECTOR') && !A.hasNetclass('PWR_BAT') && A.NetName != 'GND'")
	(constraint disallow track via)
)
